# Copy to .env at the repository root. .env is gitignored; never commit a real key.
# The harness reads exactly this variable name and passes it explicitly to the
# OpenAI SDK; it never relies on the SDK's default OPENAI_API_KEY lookup and never
# exports it into tool subprocess environments.
OPEN_AI_API_KEY=

# Optional: dedicated OpenAI project ID for the experiment (design OA01). Recorded
# in manifests when set; the preflight warns when it is empty.
OPENAI_PROJECT_ID=

# Optional: upper bound that no manifest batch_usd_cap may exceed. Leave empty
# to rely on the manifest cap alone (the manifest cap is always required).
HARNESS_MAX_USD_CAP=

# Optional: where generated runs are written (default: <repo>/runs, gitignored).
HARNESS_RUNS_DIR=

# Optional: scheduler concurrency (default 1; the design's initial policy is serial).
HARNESS_CONCURRENCY=1
